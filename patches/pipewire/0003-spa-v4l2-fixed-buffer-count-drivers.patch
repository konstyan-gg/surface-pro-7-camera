diff --git a/spa/plugins/v4l2/v4l2-utils.c b/spa/plugins/v4l2/v4l2-utils.c
index f0f774a..74ee7f2 100644
--- a/spa/plugins/v4l2/v4l2-utils.c
+++ b/spa/plugins/v4l2/v4l2-utils.c
@@ -931,6 +931,18 @@ static int probe_expbuf(struct impl *this)
 	}
 	port->max_buffers = reqbuf.count;
 
+	/* Some drivers always allocate a fixed number of buffers, whatever
+	 * count is requested (v4l2loopback gives readers the writer's count)
+	 * and then dequeue any of them. Advertise that as the minimum so the
+	 * client provides a buffer for every index the driver can return. */
+	reqbuf.count = 1;
+	if (xioctl(dev->fd, VIDIOC_REQBUFS, &reqbuf) < 0)
+		port->min_buffers = 1;
+	else
+		port->min_buffers = SPA_CLAMP(reqbuf.count, 1u, port->max_buffers);
+	spa_log_info(this->log, "'%s' buffers min:%u max:%u", this->props.device,
+			port->min_buffers, port->max_buffers);
+
 	spa_zero(expbuf);
 	expbuf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
 	expbuf.index = 0;
@@ -1469,6 +1481,14 @@ static int mmap_read(struct impl *this)
 		this->clock->next_nsec += (uint64_t) (target * SPA_NSEC_PER_SEC * corr);
 	}
 
+	if (buf.index >= port->n_buffers || port->buffers[buf.index].outbuf == NULL) {
+		spa_log_warn(this->log, "'%s' dropping frame in unknown buffer %u (have %u)",
+				this->props.device, buf.index, port->n_buffers);
+		if (xioctl(dev->fd, VIDIOC_QBUF, &buf) < 0)
+			spa_log_warn(this->log, "v4l2 %p: error qbuf: %m", this);
+		return 0;
+	}
+
 	b = &port->buffers[buf.index];
 	if (b->h) {
 		b->h->flags = 0;
@@ -1602,7 +1622,10 @@ static int spa_v4l2_use_buffers(struct impl *this, struct spa_buffer **buffers,
 		return -ENOMEM;
 	}
 
-	for (i = 0; i < reqbuf.count; i++) {
+	/* The driver may allocate more buffers than requested (v4l2loopback
+	 * gives readers the writer's buffer count). Only n_buffers entries of
+	 * buffers[] exist; touching more reads past the array and crashes. */
+	for (i = 0; i < n_buffers; i++) {
 		struct buffer *b;
 
 		b = &port->buffers[i];
@@ -1675,7 +1698,7 @@ static int spa_v4l2_use_buffers(struct impl *this, struct spa_buffer **buffers,
 
 		spa_v4l2_buffer_recycle(this, i);
 	}
-	port->n_buffers = reqbuf.count;
+	port->n_buffers = n_buffers;
 
 	return 0;
 }

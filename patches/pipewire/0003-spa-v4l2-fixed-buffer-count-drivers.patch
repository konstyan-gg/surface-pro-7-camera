 	struct v4l2_fmtdesc fmtdesc;
@@ -597,8 +598,9 @@ static int impl_node_port_enum_params(void *object, int seq,
 
 		param = spa_pod_builder_add_object(&b.b,
 			SPA_TYPE_OBJECT_ParamBuffers, id,

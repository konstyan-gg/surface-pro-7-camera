+	/*
+	 * SP7_OV5693_FULL_MODE_ONLY
+	 *
+	 * The front OV5693 2x2-binned 1296x972 mode produces only csi2
+	 * "Frame sync error" on IPU4P (independent of vblank), and the
+	 * failed start leaves the link unusable until reboot. 2592x1944
+	 * streams reliably; smaller outputs are produced by the SoftISP
+	 * SP7 raw prescale (full FOV).
+	 */
+	if (data_->sensor_->model() == "ov5693") {
+		const Size sp7FrontSize(2592, 1944);
+		bool sp7FrontFound = false;
+
+		for (const SimpleCameraData::Configuration *candidate : *configs) {
+			if (candidate->sensorSize == sp7FrontSize &&
+			    candidate->captureSize == sp7FrontSize) {
+				pipeConfig_ = candidate;
+				sp7FrontFound = true;
+				LOG(SimplePipeline, Info)
+					<< "SP7 OV5693: forcing full sensor mode "
+					<< sp7FrontSize;
+				break;
+			}
+		}
+
+		if (!sp7FrontFound)
+			LOG(SimplePipeline, Warning)
+				<< "SP7 OV5693: full sensor mode unavailable";
+	}
+
 	LOG(SimplePipeline, Debug)
 		<< "Picked "
 		<< V4L2SubdeviceFormat{ pipeConfig_->code, pipeConfig_->sensorSize, {} }
